rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    // Admin accounts are provisioned by the project owner in Firebase Console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // The store reads only which stock account is its catalog source.
    match /storeSettings/{settingId} {
      allow read: if signedIn() && settingId == 'main';
      allow write: if isAdmin();
    }

    match /profiles/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Signed-in buyers can browse stock. Only the owner admin may change it.
    match /users/{uid}/sizes/{sizeId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isAdmin();
    }
    match /users/{uid}/sizes/{sizeId}/{nested=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isAdmin();
    }
    match /users/{uid}/fonts/{fontId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isAdmin();
    }
    match /users/{uid}/deletedCharacters/{characterId} {
      allow read, write: if signedIn() && request.auth.uid == uid && isAdmin();
    }

    // Customers can place pending orders and read only their own orders.
    // The admin app verifies current prices and stock in a Firestore transaction.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'cash_on_delivery'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read: if signedIn() &&
        (resource.data.customerUid == request.auth.uid || isAdmin());
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false;
    }
  }
}
